@{
    ViewData["Title"] = "Camunda Dashboard";
    var zadaci = ViewBag.AktivniZadaci as List<Camunda.Api.Client.UserTask.UserTaskInfo>;
}

<h2>Upravljačka ploča</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

<div class="mb-4">
    <a asp-action="NovaNarudzba" class="btn btn-success">+ Otvori formu za novu narudžbu (Kupac)</a>
</div>

<h4>Aktivni zadaci u Camundi (Čekaju na akciju):</h4>

<div id="tasks-table-container">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID Narudžbe</th>
                <th>ID zadatka</th>
                <th>Naziv zadatka (Flow korak)</th>
                <th>Kreirano</th>
                <th>Akcija</th>
            </tr>
        </thead>
        <tbody>
            @if (zadaci == null || zadaci.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Trenutno nema aktivnih User Taskova. Status se automatski provjerava u pozadini...
                    </td>
                </tr>
            }
            else
            {
                foreach (var task in zadaci)
                {
                    <tr>
                        <td>
                            <code style="background-color: #f8f9fa; padding: 2px 4px; border-radius: 4px;">
                                @ViewBag.TaskBusinessKeys[task.Id]
                            </code>
                        </td>
                        <td>@task.Id</td>
                        <td>@task.Name</td>
                        <td>@task.Created.ToLocalTime()</td>
                        <td>
                            @if (task.TaskDefinitionKey == "Task_Potvrda")
                            {
                                <a asp-action="PotvrdiNarudzbu" asp-route-taskId="@task.Id" class="btn btn-warning btn-sm">Otvori odobrenje</a>
                            }
                            else if (task.TaskDefinitionKey == "Task_Isporuka")
                            {
                                <a asp-action="PotvrdiIsporuku" asp-route-taskId="@task.Id" class="btn btn-info btn-sm">Potvrdi isporuku</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Zadatak izvan očekivanog GUI-a</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<hr />
<div class="card p-3 bg-light">
    <h5>Simulacija uplate</h5>
    <form asp-action="Placanje" method="get" class="row g-3">
        <div class="col-auto">
            <input type="text" name="businessKey" class="form-control" placeholder="Npr. NAR-A1B2C3D4" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Idi na plaćanje</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        setInterval(function () {
            fetch('@Url.Action("Dashboard", "BeerOrder")')
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newTableContent = doc.getElementById('tasks-table-container').innerHTML;

                    document.getElementById('tasks-table-container').innerHTML = newTableContent;
                })
                .catch(err => console.error("Greška pri automatskom osvježavanju:", err));
        }, 3000);
    </script>
}